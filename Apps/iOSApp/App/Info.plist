	<array>
		<string>audio</string>
	</array>
	<key>NSCalendarsUsageDescription</key>
	<string>Hira needs access to your calendar to save Islamic events and reminders.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Hira needs full access to your calendar to sync and manage Islamic events.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
